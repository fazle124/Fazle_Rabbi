rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio content: read-only for website visitors.
    match /profile/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /education/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /experience/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /publicProjects/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /publicDocuments/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Public visitors may submit a message, but cannot read, edit, or delete messages.
    match /contactMessages/{messageId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'status']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 1 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }

    // Client-side aggregate statistics are optional and can be manipulated.
    // Use a Cloud Function + App Check for trusted production analytics.
    match /visitorStats/{day} {
      allow read, write: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
